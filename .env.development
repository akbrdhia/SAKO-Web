# Development Environment Variables
VITE_APP_ENV=development
VITE_APP_NAME=SAKO Web

# API Configuration
VITE_API_URL=http://sako-backend.ddev.site:8080/api/v1
VITE_API_TIMEOUT=30000

# Authentication
VITE_SESSION_DURATION=86400000
VITE_MAX_LOGIN_ATTEMPTS=10
VITE_LOCKOUT_DURATION=300000

# Security
VITE_ENABLE_HTTPS_ONLY=false
VITE_ENABLE_2FA=false
VITE_CSRF_ENABLED=true

# Features
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_DEBUG_MODE=true

# Hash Fallback (for non-HTTPS development)
VITE_ALLOW_INSECURE_HASH=true
