# Example Environment Variables
# Copy this file to .env.development or .env.production and configure accordingly

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=SAKO Web

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_SESSION_DURATION=3600000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=300000

# Security
VITE_ENABLE_HTTPS_ONLY=false
VITE_ENABLE_2FA=false
VITE_CSRF_ENABLED=true

# Features
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_DEBUG_MODE=false

# Hash Fallback (for non-HTTPS development - NEVER use in production)
VITE_ALLOW_INSECURE_HASH=false
