# Production Environment Variables
VITE_APP_ENV=production
VITE_APP_NAME=SAKO Web

# API Configuration
VITE_API_URL=https://api.sako.kemenkop.go.id/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_SESSION_DURATION=3600000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=300000

# Security
VITE_ENABLE_HTTPS_ONLY=true
VITE_ENABLE_2FA=true
VITE_CSRF_ENABLED=true

# Features
VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_CONSOLE_LOGS=false
VITE_ENABLE_DEBUG_MODE=false

# Hash Fallback (MUST be false in production)
VITE_ALLOW_INSECURE_HASH=false
